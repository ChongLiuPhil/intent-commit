{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-commit.dev/schemas/argument-map.schema.json",
  "title": "Intent Commit Federated Argument Map",
  "type": "object",
  "required": ["protocol", "protocolVersion", "federationVersion", "type", "id", "issuer", "publishedAt", "actor", "subject", "structure", "proof"],
  "properties": {
    "protocol": { "const": "intent-commit" },
    "protocolVersion": { "type": "string" },
    "federationVersion": { "const": "1.3" },
    "type": { "const": "federated-argument-map" },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": "string", "format": "uri" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "subject": { "type": "string", "format": "uri" },
    "structure": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "kind", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
              "kind": { "enum": ["claim", "reason", "objection", "qualification"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["source", "target", "predicate"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "predicate": { "enum": ["supports", "challenges", "qualifies"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["type", "algorithm", "keyId", "signature"],
      "properties": {
        "type": { "const": "IntentCommitEd25519Signature2026" },
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "format": "uri-reference" },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
