{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-commit.dev/schemas/federation-relation.schema.json",
  "title": "Intent Commit Federation Relation",
  "type": "object",
  "required": ["protocol", "protocolVersion", "federationVersion", "type", "id", "issuer", "publishedAt", "actor", "subject", "reason", "proof"],
  "properties": {
    "protocol": { "const": "intent-commit" },
    "protocolVersion": { "type": "string" },
    "federationVersion": { "enum": ["1.1", "1.2"] },
    "type": { "enum": ["federated-retraction", "federated-revision"] },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": "string", "format": "uri" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "subject": { "type": "string", "format": "uri" },
    "replacement": { "type": "string", "format": "uri" },
    "reason": { "type": "string", "maxLength": 1000 },
    "proof": {
      "type": "object",
      "required": ["type", "algorithm", "keyId", "signature"],
      "properties": {
        "type": { "const": "IntentCommitEd25519Signature2026" },
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "format": "uri-reference" },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "federated-revision" } } },
      "then": { "required": ["replacement"] },
      "else": { "not": { "required": ["replacement"] } }
    }
  ],
  "additionalProperties": false
}
