{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-commit.dev/schema/committed-message-1.0.json",
  "title": "Intent Commit Committed Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocolVersion", "type", "state", "id", "room", "author", "statement", "committedAt"],
  "properties": {
    "protocol": { "const": "intent-commit" },
    "protocolVersion": { "const": "1.0" },
    "type": { "const": "committed-message" },
    "state": { "const": "COMMITTED" },
    "id": { "type": "string", "minLength": 1 },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": { "code": { "type": "string", "minLength": 1 } }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "statement": { "type": "string", "minLength": 1 },
    "committedAt": { "type": "string", "format": "date-time" }
  }
}
